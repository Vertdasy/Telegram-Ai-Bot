# Required: create a bot with @BotFather and paste its token here.
TELEGRAM_TOKEN=

# Required: API key from the provider matching AI_BASE_URL and ID_MODEL.
AI_API_KEY=

# Must match your provider. This is the project's current default endpoint;
# replace it if you use OpenAI, OpenRouter, or another compatible provider.
AI_BASE_URL=https://ai.starimg.ru/v1

# Model names must be available from the provider configured above.
ID_MODEL=deepseek-v4.1-flash
VISION_MODEL=deepseek-v4.1-flash
FALLBACK_MODEL=deepseek-v4-flash
MODELS=deepseek-v4.1-flash,deepseek-v4-flash,deepseek-v4-pro

# Comma-separated Telegram user IDs allowed to administer the bot.
ADMIN_IDS=

# Optional web-search API keys. Leave blank to use keyless fallbacks.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional tuning; defaults shown here.
WEB_SEARCH=1
MEMORY_LEN=30
RATE_PER_MIN=5
RATE_PER_DAY=100
MAX_FILE_MB=10
MAX_DOC_CHARS=30000
MAX_DOCS=5

# Optional: leave blank to let the application choose its default database path.
DB_PATH=
